# --- Production / Vercel (daily backups) ---
# After deploying, also run supabase/system_backups.sql (or npm run migrate:db) once.
# Cron hits /api/cron-backup at 18:30 UTC = midnight Asia/Colombo (see vercel.json).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CRON_SECRET=long-random-string

# --- Amazon Textract bill scan (Techloom Edge Function ONLY) ---
# Do NOT add VITE_AWS_* or any AWS keys here / in Vercel frontend envs.
# Frontend UI flag only (Analyze Bill / OCR review). Default OFF when unset.
# VITE_ENABLE_BILL_OCR=false
# Set secret NAMES on Supabase Edge Functions (see docs/TEXTRACT_PILOT_TECHLOOM.md):
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_REGION   (= eu-west-1 for the pilot)

# --- Asgardeo customer login (KAIONEX FMS SPA, PKCE, no client secret) ---
# Create the application in https://console.asgardeo.io/t/techloomai/app/getting-started
# Redirect and logout URL: http://localhost:5173
# Release the groups claim. FMS allows only the kaionex-fms group.
